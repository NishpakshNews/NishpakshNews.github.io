dary":["life"],"tertiary":["sport-films"]},"places":[],"people":["Lakshya Raichandani","Afghanistan","Mohammad Ali","Pakistan","VK Vineeth","Amir Hamza","Aryan Savsani","Noor Ali Niazi"],"narrative":{"paragraphs":[[{"text":"गुरुवार 12 नवंबर 2026 को एसीसी मेन्स अंडर-19 एशिया कप 2026 के सेमीफाइनल में भारत अंडर-19 ने अफगानिस्तान अंडर-19 को आठ विकेट से हराया।","ids":[126194],"class":"partial","sources":[1,2]}],[{"text":"8 नवंबर को, हसनैन दार ने 38 रन बनाए और हमज़ा जहूर के साथ 107 रनों की साझेदारी की, जबकि स्किपर लक्ष्य रायचंदानी (0), आर्यवीर सहवाग (22), वीके विनीत (8), यशबर्धन चौहान (1), और अन्वय द्रविड़ (10) बड़े रन बनाने में विफल रहे।","ids":[-112993,-112994],"class":"single","sources":[3]},{"text":"पाकिस्तान के तेज़ गेंदबाज़ अली रज़ा, रिज़वानुल्लाह और स्पिनर निकाब शफीक ने तीन-तीन विकेट झटके, और वे एसीसी मेन्स अंडर-19 एशिया कप 2026 में ग्रुप ए अंक तालिका में शीर्ष पर हैं।","ids":[-112996,-112997],"class":"single","sources":[3]}],[{"text":"गुरुवार 12 नवंबर 2026 को भारत ने 36.5 ओवरों में लक्ष्य हासिल कर लिया, और 230/2 पर पारी समाप्त की।","ids":[126184,126195],"class":"single","sources":[1,2]},{"text":"रायचंदानी गेंद को मोहम्मद अली के पास उछालने के बाद आउट हो गए।","ids":[126185],"class":"single","sources":[2]}],[{"text":"गुरुवार 12 नवंबर 2026 को अफगानिस्तान ने 50 ओवरों में 227/8 बनाए।","ids":[126196],"class":"single","sources":[1]},{"text":"उन्होंने टॉस जीता और बल्लेबाज़ी चुनी।","ids":[126198],"class":"single","sources":[1]},{"text":"रायचंदानी ने नाबाद 93 रन बनाए।","ids":[126201],"class":"single","sources":[1]}],[{"text":"रायचंदानी ने गुरुवार को अंडर-19 एशिया कप सेमीफाइनल में 93 रन बनाए।","ids":[126180],"class":"single","sources":[2]},{"text":"आर्यन सवसाणी ने एक ही ओवर में आमीर हमज़ा और ताहिर सरवरी को आउट किया।","ids":[126199],"class":"single","sources":[1]}],[{"text":"वीके विनीत ने नूर अली नियाज़ी पर छक्का लगाकर मुकाबला समाप्त किया।","ids":[126200],"class":"single","sources":[1]},{"text":"रायचंदानी का पहला अर्धशतक 39 गेंदों में आया।","ids":[126189],"class":"single","sources":[2]},{"text":"नोमान सलारज़ई और शाह फैसल रहीमी प्रत्येक ने 51 रन बनाए।","ids":[126205],"class":"single","sources":[1]}],[{"text":"ईशान सूद ने 43 रन देकर 3 विकेट लिए, और सोहैल खान ने 56 रन देकर 1 विकेट लिया।","ids":[126202,126210],"class":"single","sources":[1]},{"text":"नियाज़ी ने 58 रन देकर 1 विकेट लिया, और सवसाणी ने 29 रन देकर 2 विकेट लिए।","ids":[126211,126209],"class":"single","sources":[1]}],[{"text":"वीके विनीत 57 रन बनाकर नाबाद रहे, और सहवाग ने 57 गेंदों में 51 रन बनाए।","ids":[126207,126208],"class":"single","sources":[1,2]}],[{"text":"गुरुवार 12 नवंबर 2026 को भारत अंडर-19 एशिया कप के फाइनल में पाकिस्तान से भिड़ेगा, जो 14 नवंबर 2026 के लिए निर्धारित था।","ids":[126193,126187],"class":"single","sources":[1,2]},{"text":"वे शनिवार को फाइनल में पाकिस्तान के खिलाफ खेलेंगे।","ids":[126212],"class":"single","sources":[1]}]],"section_keys":["news","background","happened","happened","performers","performers","performers","numbers","next"],"sources":[{"n":1,"url":"https://timesofindia.indiatimes.com/sports/cricket/news/lakshya-raichandanis-93-powers-india-u19-to-eight-wicket-semifinal-win-over-afghanistan-sets-up-blockbuster-final-against-pakistan/articleshow/135768235.cms","outlet":"Times of India","title":"Raichandani's 93 powers India U19 to 8-wicket semifinal win over Afghanistan","perspective":"–","read":true,"readable":true},{"n":2,"url":"https://www.thehindu.com/sport/cricket/u19-asia-cup-raichandanis-93-sees-india-to-final-to-face-pakistan-in-title-clash/article71695309.ece","outlet":"The Hindu","title":"U19 Asia Cup: Raichandani’s 93 sees India to final, to face Pakistan in title clash","perspective":"–","read":true,"readable":true},{"n":3,"url":"https://www.aninews.in/news/sports/cricket/hamza-zahoors-unbeaten-ton-guides-pakistan-to-3-wicket-win-over-india-in-acc-mens-u19-asia-cup-202620261108191540","outlet":"","title":"","perspective":"–","read":true,"readable":true}],"other_coverage":[{"text":"पाकिस्तान ने बांग्लादेश को नौ विकेट से हराकर खिताबी मुकाबले में 