ass":"single","sources":[2]},{"text":"Tilak Varma scored 51 not out off 26 balls.","ids":[67370],"class":"single","sources":[2]}],[{"text":"Hasaranga claimed 38 wickets in 2024.","ids":[67361],"class":"unverified","sources":[1,2]},{"text":"Singh claimed 38 wickets in 2026.","ids":[67356],"class":"single","sources":[2]},{"text":"Arshdeep claimed 36 wickets in 2024 and 33 in 2022.","ids":[67362],"class":"single","sources":[2]},{"text":"Varun Chakaravarthy took 36 wickets in 2025.","ids":[67363,67385],"class":"single","sources":[1,2]}],[{"text":"Axar Patel claimed 32 wickets in 2026.","ids":[67364],"class":"single","sources":[2]},{"text":"Singh has achieved 38 T20 International wickets in the year 2026 so far.","ids":[67382],"class":"single","sources":[1]},{"text":"Arshdeep took 36 wickets in 2024.","ids":[67384],"class":"single","sources":[1]}],[{"text":"Singh took 33 wickets in 2022.","ids":[67386],"class":"single","sources":[1]},{"text":"Patel has achieved 32 wickets in 2026 so far.","ids":[67387],"class":"single","sources":[1]},{"text":"Josh Little leads the list of most wickets in a calendar year in T20 International cricket with 39 wickets in 2022.","ids":[67392],"class":"partial","sources":[1,2]}],[{"text":"Tim Seifert scored 7 runs in the second T20 match against New Zealand.","ids":[67388],"class":"single","sources":[1]}],[{"text":"Singh is India's most successful T20 International bowler with 148 wickets in 101 T20 International matches.","ids":[67391],"class":"single","sources":[1]}],[{"text":"India was at 112/6 after losing wickets at regular intervals.","ids":[67369],"class":"single","sources":[2]}],[{"text":"This recent milestone places Arshdeep among the top-performing bowlers from full-member nations in men's T20Is over a single calendar year.","ids":[67371],"class":"single","sources":[2]},{"text":"Even though the batting battle generated late excitement, Arshdeep's accomplishment remained a notable individual highlight of India's T20I series.","ids":[6