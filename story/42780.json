ce":"asserts"}]},{"text":"? because arshdeep Singh took two wickets in the second T20 International match against New Zealand in Christchurch on 24 October 2026.","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Aaj Tak","url":"https://www.aajtak.in/sports/cricket/story/arshdeep-singh-most-t20i-wickets-calendar-year-2026-breaks-bhuvneshwar-kumar-record-tspok-dskc-2679047-2026-10-24","stance":"asserts"}]}],"context":[]},"payload_hi":{"story_id":42780,"headline":"भारत का टी20 गेंदबाजी रिकॉर्ड तब टूटा जब अर्शदीप सिंह ने दो बल्लेबाजों को आउट किया","counts":{"articles":2,"independent_sources":2,"outlets":2},"has_established":false,"qualified_by":"express","perspective_mode":"none","perspectives":{"–":["Aaj Tak","Times of India"]},"framing":[],"suicide":false,"thread":42780,"parents":[],"children":[],"written_at":"2026-10-24T12:24:49","category":{"primary":["life"],"secondary":["sport-films"]},"places":[],"people":["Arshdeep Singh","New Zealand","Glenn Phillips","Tim Seifert","Bhuvneshwar Kumar","Axar Patel","Bevon Jacobs","Christchurch"],"narrative":{"paragraphs":[[{"text":"अर्शदीप सिंह ने 24 अक्टूबर 2026 को न्यू जीलैंड के खिलाफ दूसरे टी20 मैच में टिम साइफर्ट और ग्लेन फिलिप्स को आउट किया।","ids":[67377],"class":"single","sources":[1]}],[{"text":"शनिवार को, सिंह ने न्यू जीलैंड के खिलाफ मैच में टिम साइफर्ट को जल्दी आउट किया।","ids":[67352],"class":"single","sources":[2]}],[{"text":"मिचेल सैंटनर ने भारत के लक्ष्य का पीछा करने के दौरान नमन धीर को आउट किया।","ids":[67354],"class":"single","sources":[2]}],[{"text":"24 अक्टूबर 2026 को, सिंह ने साइफर्ट और ग्लेन फिलिप्स को आउट किया।","ids":[67378],"class":"single","sources":[1]}],[{"text":"मील के पत्थर ने सिंह की निरंतरता को रेखांकित किया।","ids":[67398],"class":"single","sources":[2]},{"text":"घटना ने सबसे छोटे प्रारूप में भारतीय गेंदबाजी लाइनअप के लिए अर्शदीप के बढ़ते मूल्य को उजागर किया।","ids":[67399],"class":"single","sources":[2]}],[{"text":"सिंह अब वनिंदू हसरंगा के बराबर हैं।","ids":[67400],"class":"single","sources":[2]}],[{"text":"सिंह अब जोश लिटिल के आंकड़े से एक विकेट पीछे हैं।","ids":[67401],"class":"single","sources":[2]}],[{"text":"शनिवार को, सिंह ने एक कैलेंडर वर्ष में टी20 अंतरराष्ट्रीय में भारत के अग्रणी विकेट लेने वाले गेंदबाज बनने के लिए भुवनेश्वर कुमार को पीछे छोड़ दिया।","ids":[67351],"class":"unverified","sources":[1,2]},{"text":"सिंह शनिवार 24 अक्टूबर 2026 को क्राइस्टचर्च के हेग्ली ओवल में न्यू जीलैंड के खिलाफ दूसरे टी20 अंतरराष्ट्रीय के दौरान एक कैलेंडर वर्ष में इस प्रारूप में भारत के अग्रणी विकेट लेने वाले गेंदबाज बने।","ids":[67355],"class":"single","sources":[2]},{"text":"भुवनेश्वर कुमार ने 2022 में 37 विकेट का पिछला भारतीय रिकॉर्ड बनाया था।","ids":[67357],"class":"partial","sources":[1,2]},{"text":"अर्शदीप को इस मुकाम तक पहुंचने के लिए 26 पारियों की आवश्यकता थी।","ids":[67358],"class":"single","sources":[2]}],[{"text":"भुवनेश्वर कुमार ने 2022 में अपने 37 विकेट लेने के लिए 31 पारियां ली थीं।","ids":[67359],"class":"single","sources":[2]},{"text":"यह 38 विकेट के साथ एक कैलेंडर वर्ष में एक भारतीय गेंदबाज द्वारा सर्वाधिक टी20 अंतरराष्ट्रीय विकेट का रिकॉर्ड रखता है।","ids":[67395],"class":"single","sources":[1]},{"text":"यह एक कैलेंडर वर्ष में 37 विकेट के साथ दूसरे स्थान पर है।","ids":[67396],"class":"single","sources":[1]}],[{"text":"सिंह ने शनिवार को क्राइस्टचर्च के हेग्ली ओवल में न्यू जीलैंड के खिलाफ दूसरे टी20 अंतरराष्ट्रीय के दौरान अपने चार ओवरों में 33 रन देकर दो विकेट लेते हुए 2/33 के आंकड़ों के साथ समापन किया।","ids":[67350,67375,67390],"class":"single","sources":[1,2]}],[{"text":"ग्लेन फिलिप्स और बेवोन जैकोब्स ने शनिवार को 116 रनों की चौथे विकेट की साझेदारी की, और 24 अक्टूबर 2026 को सिंह द्वारा उनकी पारी समाप्त करने से पहले फिलिप्स ने 70 रन बनाए।","ids":[67353,67379],"class":"single","sources":[1,2]},{"text":"बेवोन जैकोब्स ने 46 गेंदों में 58 रनों का योगदान दिया।","ids":[67367],"class":"single","sources":[2]}],[{"text":"ग्लेन फिलिप्स ने न्यू जीलैंड के खिलाफ दूसरे टी20 मैच में 70 रन बनाए।","ids":[67389],"class":"single","sources":[1]}],[{"text":"भारत ने 24 अक्टूबर 2026 को दूसरे टी20 मैच में न्यू जीलैंड को चार विकेट से हराया।","ids":[67376],"class":"single","sources":[1]},{"text":"यह 5.2 ओवर के बाद 41/3 पर सिमट गई थी, और 20 ओवर में 180/5 तक उबर गई।","ids":[67365,67368],"class":"single","sources":[2]},{"text":"तिलक वर्मा ने 26 गेंदों में 51 रन नाबाद बनाए।","ids":[67370],"class":"single","sources":[2]}],[{"text":"हसरंगा ने 2024 में 38 विकेट लिए।","ids":[67361],"class":"unverified","sources":[1,2]},{"text":"सिंह ने 2026 में 38 विकेट लिए।","ids":[67356],"class":"single","sources":[2]},{"text":"अर्शदीप ने 2024 में 36 विकेट और 2022 में 33 विकेट लिए।","ids":[67362],"class":"single","sources":[2]},{"text":"वरुण चक्रवर्ती ने 2025 में 36 विकेट लिए।","ids":[67363,67385],"class":"single","sources":[1,2]}],[{"text":"अक्षर पटेल ने 2026 में 32 विकेट लिए।","ids":[67364],"class":"single","sources":[2]},{"text":"सिंह ने वर्ष 2026 में अब तक 38 टी20 अंतरराष्ट्रीय विकेट हासिल किए हैं।","ids":[67382],"class":"single","sources":[1]},{"text":"अर्शदीप ने 2024 में 36 विकेट लिए।","ids":[67384],"class":"single","sources":[1]}],[{"text":"सिंह ने 2022 में 33 विकेट लिए।","ids":[67386],"class":"single","sources":[1]},{"text":"पटेल ने 2026 में अब तक 32 विकेट हासिल किए हैं।","ids":[67387],"class":"single","sources":[1]},{"text":"जोश लिटिल 2022 में 39 विकेट के साथ टी20 अंतरराष्ट्रीय क्रिकेट में एक कैलेंडर वर्ष में सबसे अधिक विकेट लेने वालों की सूची में शीर्ष पर हैं।","ids":[67392],"class":"partial","sources":[1,2]}],[{"text":"टिम साइफर्ट ने न्यू जीलैंड के खिलाफ दूसरे टी20 मैच में 7 रन बनाए।","ids":[67388],"class":"single","sources":[1]}],[{"text":"सिंह 101 टी20 अंतरराष्ट्रीय मैचों में 148 विकेट के साथ भारत के सबसे सफल टी20 अंतरराष्ट्रीय गेंदबाज हैं।","ids":[67391],"class":"single","sources":[1]}],[{"text":"भारत नियमित अंतराल पर विकेट खोने के बाद 112/6 पर था।","ids":[67369],"class":"single","sources":[2]}],[{"text":"यह हालिया मील का पत्थर अर्शदीप को एक कैलेंडर वर्ष में पुरुषों के टी20 अंतरराष्ट्रीय में पूर्ण-सदस्य देशों के शीर्ष प्रदर्शन करने वाले