icles":5,"independent_sources":4,"outlets":4},"has_established":true,"qualified_by":"interim","perspective_mode":"none","perspectives":{"–":["Amar Ujala","Live Hindustan","News18 Hindi","The Hindu"]},"framing":[],"suicide":false,"thread":40155,"parents":[],"children":[],"written_at":"2026-10-24T01:14:28","category":{"primary":["world","politics"],"secondary":["defence","government"]},"places":[],"people":["Rajnath Singh","Commanders Conference","Land Warfare Doctrine","Operation Sindoor","United Nations Journal"],"narrative":{"paragraphs":[[{"text":"रक्षा मंत्री राजनाथ सिंह ने सेना के वरिष्ठ नेतृत्व से अगले 20-30 वर्षों के लिए एक दीर्घकालिक रणनीतिक विजन विकसित करने का आह्वान किया।","ids":[66856],"class":"unverified","sources":[1,2,3,4]}],[{"text":"शुक्रवार 23 अक्टूबर को सिंह ने नई दिल्ली में आर्मी कमांडर्स कॉन्फ्रेंस को संबोधित किया, और कार्यक्रम के समापन दिवस को संबोधित किया।","ids":[66801,66853],"class":"single","sources":[1,2,3,4]}],[{"text":"सिंह ने लैंड वॉरफेयर डॉक्ट्रिन जारी किया।","ids":[66861],"class":"established","sources":[1,3,4]}],[{"text":"सिंह ने वार्षिक यूनाइटेड नेशंस जर्नल का अनावरण किया।","ids":[66855],"class":"single","sources":[4]}],[{"text":"सिंह ने कहा, \"भारत का रक्षा उत्पादन 2025-26 वित्तीय वर्ष में 1.78 लाख करोड़ रुपये तक पहुंच गया,\" और भारत का रक्षा निर्यात 2025-26 वित्तीय वर्ष में लगभग 38,000 करोड़ रुपये के रिकॉर्ड स्तर पर पहुंच गया।","ids":[66809,66863],"class":"established","sources":[1,2,3,4]}],[{"text":"सिंह ने कहा कि बदलती परिस्थितियों के अनुसार सैन्य रणनीतियों को बदला जाना चाहिए, सेना की तैयारी ऐसी होनी चाहिए कि वह तत्काल चुनौतियों और भविष्य के खतरों का जवाब दे सके, और ऑपरेशन सिंदूर की सफलता तैयारी, नई सोच, समन्वय और आधुनिक हथियारों के कारण थी।","ids":[66803,66804,66805],"class":"single","sources":[2]}]],"section_keys":["news","happened","happened","happened","say","say"],"sources":[{"n":1,"url":"https://www.amarujala.com/india-news/army-focuses-on-ai-and-drone-technology-is-india-ready-for-future-challenges-what-rajnath-singh-says-2