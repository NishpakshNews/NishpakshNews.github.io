[6,7]}],[{"text":"मंगलवार को प्रधानमंत्री नरेंद्र मोदी और प्रधानमंत्री मार्क कार्नी ने टेलीफोन पर बातचीत की।","ids":[53125,53133],"class":"single","sources":[2,3,4,9,10]}],[{"text":"कार्नी ने यात्रा की तारीखों की पुष्टि की।","ids":[53158],"class":"single","sources":[1]},{"text":"दिसंबर में मोदी कनाडा का दौरा करेंगे।","ids":[53124],"class":"established","sources":[3,9,11]}],[{"text":"प्रस्तावित कॉम्प्रिहेंसिव इकोनॉमिक पार्टनरशिप एग्रीमेंट से 2030 तक द्विपक्षीय व्यापार को दोगुना करने के प्रयासों को समर्थन मिलने की उम्मीद है।","ids":[53153],"class":"unverified","sources":[9,10]}],[{"text":"यात्रा का उद्देश्य व्यापार, ऊर्जा, प्रौद्योगिकी, सुरक्षा और जन-से-जन संबंधों में सहयोग का विस्तार करना है।","ids":[53155],"class":"unverified","sources":[4,9]}],[{"text":"कनाडा और भारत का लक्ष्य जल्द से जल्द कॉम्प्रिहेंसिव इकोनॉमिक पार्टनरशिप एग्रीमेंट पर बातचीत पूरी करना है, और मोदी और कार्नी कॉम्प्रिहेंसिव इकोनॉमिक पार्टनरशिप एग्रीमेंट (CEPA) पर बातचीत पूरी करने के लिए प्रतिबद्ध हैं, कैनेडियन प्रधानमंत्री कार्यालय ने कहा।","ids":[53128,53147],"class":"single","sources":[3,9,10]}],[{"text":"मोदी ने कार्नी के साथ हुई बातचीत को सौहार्दपूर्ण और उत्पादक बताया।","ids":[53126],"class":"single","sources":[3]}],[{"text":"राइट हॉन कार्नी ने कहा कि मोदी का कनाडा दौरा मुख्य रूप से टोरंटो में होगा।","ids":[53275],"class":"single","sources":[11]}],[{"text":"एक अज्ञात सूत्र ने कहा कि मोदी टोरंटो में एक प्रवासी कार्यक्रम को संबोधित करेंगे।","ids":[53276],"class":"single","sources":[11]}],[{"text":"दोनों देश इस साल के अंत तक एक व्यापार समझौते को अंतिम रूप देने की दिशा में काम कर रहे हैं।","ids":[53141],"class":"unverified","sources":[2,3]}],[{"text":"मोदी के 13 दिसंबर से 15 दिसंबर 2026 तक G20 शिखर सम्मेलन के लिए अमेरिका जाने की उम्मीद है।","ids":[53277],"class":"single","sources":[11]}],[{"text":"मोदी 16 दिसंबर से 17 दिसंबर 2026 तक ब्रसेल्स का दौरा करेंगे, ताकि यूरोपीय संघ मुक्त व्यापार समझौते पर हस्ताक्षर किए जा सकें और द्विपक्षीय वार्ता की जा सके।","ids":[53278],"class":"single","sources":[11]}]]