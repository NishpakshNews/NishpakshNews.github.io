icle71747210.ece","stance":"asserts"}]},{"text":"Vaibhav Kalta and Aryaman Singh's performance was insufficient for Himachal Pradesh.","verdict":"unverified","n_sources":1,"sources":[{"outlet":"The Hindu","url":"https://www.thehindu.com/sport/cricket/syed-mushtaq-ali-trophy-azharuddeens-century-powers-kerala-into-the-super-league/article71747210.ece","stance":"asserts"}]},{"text":"Salman Nizar scored 26 not out.","verdict":"unverified","n_sources":1,"sources":[{"outlet":"The Hindu","url":"https://www.thehindu.com/sport/cricket/syed-mushtaq-ali-trophy-azharuddeens-century-powers-kerala-into-the-super-league/article71747210.ece","stance":"asserts"}]},{"text":"Abdul Basith scored 24 not out for Kerala.","verdict":"unverified","n_sources":1,"sources":[{"outlet":"The Hindu","url":"https://www.thehindu.com/sport/cricket/syed-mushtaq-ali-trophy-azharuddeens-century-powers-kerala-into-the-super-league/article71747210.ece","stance":"asserts"}]},{"text":"Kerala batter Mohammed Azharuddeen scored a century in a Syed Mushtaq Ali Trophy match against Himachal Pradesh, and after that Mohammed Azharuddeen showed the name 'Samson' written on his bat to the camera.","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Times of India","url":"https://timesofindia.indiatimes.com/sports/cricket/news/mohammed-azharuddeen-flashes-samson-on-bat-after-century-sanju-samsons-reaction-caught-on-camera/articleshow/136183585.cms","stance":"asserts"}]}],"context":[{"text":"The camera captured Sanju Samson's reaction to the gesture while he was sitting in the dressing room.","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Times of India","url":"https://timesofindia.indiatimes.com/sports/cricket/news/mohammed-azharuddeen-flashes-samson-on-bat-after-century-sanju-samsons-reaction-caught-on-camera/articleshow/136183585.cms","stance":"asserts"}]}]},"payload_hi":{"story_id":99187,"headline":"ओपनिंग बल्लेबाज मोहम्मद अज़हरुद्दीन ने टी20 में दूसरा शतक लगाने के बाद सैमसन को श्रद्धांजलि दी","counts":{"articles":2,"independent_sources":2,"outlets":2},"has_established":false,"qualified_by":"express","perspective_mode":"none","perspectives":{"–":["The Hindu","Times of India"]},"framing":[],"suicide":false,"thread":99187,"parents":[],"children":[],"written_at":"2026-11-26T20:51:59","category":{"v":2,"primary":["india"],"secondary":["life"],"tertiary":["sport-films"]},"places":["kerala"],"people":["Mohammed Azharuddeen","Openers Azharuddeen","Sanju Samson","Abdul Basith","Syed Mushtaq","Rohan Kunnummal","Salman Nizar","Arpit Guleria"],"narrative":{"paragraphs":[[{"text":"26 नवंबर को, मोहम्मद अज़हरुद्दीन ने 56 गेंदों में अपना शतक पूरा किया।","ids":[172325],"class":"single","sources":[1]}],[{"text":"शुक्रवार को, सैयद मुश्ताक अली ट्रॉफी में हिमाचल प्रदेश के खिलाफ अज़हरुद्दीन ने 57 गेंदों में 101 रन का अपना दूसरा टी20 शतक बनाया।","ids":[172338],"class":"single","sources":[2]},{"text":"अज़हरुद्दीन ने हिमाचल प्रदेश के खिलाफ एक सैयद मुश्ताक अली ट्रॉफी मैच में शतक बनाया, बल्लेबाज ने गुरुवार को।","ids":[172319],"class":"single","sources":[1]},{"text":"उन्होंने 56 गेंदों में अपना शतक पूरा किया।","ids":[172344],"class":"single","sources":[2]},{"text":"अज़हरुद्दीन ने अर्पित गुलेरिया की गेंद पर छक्का लगाया।","ids":[172345],"class":"single","sources":[2]}],[{"text":"शुक्रवार को, केरल ने सैयद मुश्ताक अली ट्रॉफी में सुपर लीग के लिए क्वालीफाई करने के वास्ते हिमाचल प्रदेश पर 67 रन की जीत दर्ज की।","ids":[172339],"class":"single","sources":[2]},{"text":"उसने हिमाचल प्रदेश के खिलाफ चार विकेट पर 268 रन बनाए।","ids":[172340],"class":"single","sources":[2]},{"text":"वह पांच विकेट पर 201 रन पर समाप्त हुआ।","ids":[172341],"class":"single","sources":[2]},{"text":"अब्दुल बासित ने केरल को अंत में मजबूती प्रदान की।","ids":[172323],"class":"single","sources":[1]}],[{"text":"गुरुवार को, अज़हरुद्दीन ने कैमरे को अपना बल्ला दिखाया जिस पर 'संजू सैमसन' नाम लिखा था।","ids":[172320],"class":"single","sources":[1]},{"text":"सैमसन ने पहले बल्लेबाजी करने का फैसला किया।","ids":[172342],"class":"single","sources":[2]},{"text":"विकेटकीपर-बल्लेबाज ने रोहन कुन्नुम्मल के साथ 82 रनों की ओपनिंग साझेदारी की।","ids":[172322],"class":"single","sources":[1]}],[{"text":"मृदुल सुर्रोच ने हिमाचल प्रदेश के लिए दो विकेट लिए।","ids":[172324],"class":"single","sources":[1]},{"text":"एम.डी. निधीश और के.एम. आसिफ ने हिमाचल प्रदेश के ओपनर्स को आउट किया।","ids":[172346],"class":"single","sources":[2]},{"text":"वैभव काल्टा और आर्यमन सिंह का प्रदर्शन हिमाचल प्रदेश के लिए नाकाफी रहा।","ids":[172360],"class":"single","sources":[2]}],[{"text":"कैमरे ने ड्रेसिंग रूम में बैठे सैमसन की इस इशारे पर प्रतिक्रिया को कैद किया।","ids":[172337],"class":"single","sources":[1]}],[{"text":"कुन्नुम्मल ने 16 गेंदों में 35 रन बनाए।","ids":[172330],"class":"unverified","sources":[1,2]},{"text":"सैमसन ने 21 गेंदों में 44 रन बनाए।","ids":[172327],"class":"single","sources":[1]},{"text":"विष्णु विनोद ने 11 गेंदों में 22 रन बनाए।","ids":[172331],"class":"single","sources":[1]},{"text":"बासित ने पांच गेंदों में 24 रन बनाए और नाबाद रहे।","ids":[172333],"class":"single","sources":[1]},{"text":"सैमसन ने 21 गेंदों में 44 रन बनाए।","ids":[172351],"class":"single","sources":[2]}],[{"text":"केरल ने 20 ओवर में 268/4 का कुल स्कोर बनाया, जो 13.40 की रन रेट से चार विकेट पर 268 रन पर समाप्त हुआ।","ids":[172326,172335],"class":"single","sources":[1,2]},{"text":"केरल का चार विकेट पर 268 का कुल स्कोर पीसीए न्यू इंटरनेशनल स्टेडियम में सबसे बड़ा कुल स्कोर था।","ids":[172348],"class":"single","sources":[2]},{"text":"बासित ने केरल के लिए नाबाद 24 रन बनाए।","ids":[172365],"class":"single","sources":[2]}],[{"text":"विकेटकीपर-बल्लेबाज की पारी में आठ चौके और छह छक्के शामिल थे, और उसने 177.19 के स्ट्राइक रेट से रन बनाए।","ids":[172328,172329],"class":"single","sources":[1]}],[{"text":"सलमान निज़ार ने 15 गेंदों में 26 रन बनाए और नाबाद रहे।","ids":[172332],"class":"single","sources":[1]},{"text":"निज़ार ने नाबाद 26 रन बनाए।","ids":[172364],"class":"single","sources":[2]}],[{"text":"बासित ने 480 के स्ट्राइक रेट से रन बनाए।","ids":[172334],"class":"single","sources":[1]},{"text":"उन्होंने हिमाचल प्रदेश के लिए एक-एक विकेट लिया।","ids":[172336],"class":"single","sources":[1]},{"text":"उन्होंने हिमाचल प्रदेश को 97 रन पर पांच विकेट पर रोक दिया।","ids":[172359],"class":"single","sources":[2]}],[{"text":"अज़हरुद्दीन और कुन्नुम्मल ने पावरप्ले के अंदर 82 रन जोड़े, और फिर उन्होंने सैमसन के साथ दूसरे विकेट के लिए 77 रन जोड़े।","ids":[172349,172352],"class":"single","sources":[2]}]],"section_keys":["news","happened","happened","happened","happened","say","numbers","numbers","numbers","numbers","numbers","numbers"],"sources":[{"n":1,"url":"https://timesofindia.indiatimes.com/sports/cricket/news/mohammed-azharuddeen-flashes-samson-on-bat-after-century-sanju-samsons-reaction-caught-on-camera/articleshow/136183585.cms","outlet":"Times of India","title":"Batter flashes 'Samson' on bat after century; Sanju Samson's reaction goes viral","perspective":"–","read":true,"readable":true},{"n":2,"url":"https://www.thehindu.com/sport/cricket/syed-mushtaq-ali-trophy-azharuddeens-century-powers-kerala-into-the-super-league/article71747210.ece","outlet":"The Hindu","title":"Syed Mushtaq Ali Trophy: Azharuddeen’s century powers Kerala into the Super League","perspective":"–","read":true,"readable":true}],"other_coverage":[{"text":"आंध्र ने महाराष्ट्र पर सात विकेट से जीत दर्ज की","ids":[172343],"class":"single","sources":[2]},{"text":"आंध्र ने चार गेंद शेष रहते 181 का लक्ष्य हासिल कर लिया","ids":[172353],"class":"single","sources":[2]},{"text":"आंध्र ग्रुप में शीर्ष स्थान पर पहुंच गया","ids":[172354],"class":"single","sources":[2]},{"text":"अश्विन हेब्बार ने आंध्र के लिए 16 गेंदों में 34 रन बनाए।","ids":[172355],"class":"single","sources":[2]},{"text":"अर्शिन कुलकर्णी ने महाराष्ट्र के लिए 37 गेंदों में 56 रन बनाए।","ids":[172356],"class":"single","sources":[2]},{"text":"महाराष्ट्र ने 20 ओवर में सात विकेट पर 180 रन बनाए।","ids":[172357],"class":"single","sources":[2]},{"text":"आंध्र ने सैयद मुश्ताक अली ट्रॉफी में महाराष्ट्र के खिलाफ