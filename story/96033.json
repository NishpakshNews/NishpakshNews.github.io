story_id":96033,"headline":"दिल्ली पुलिस ने ईस्ट दिल्ली के एक कैफे में एक महिला के सामूहिक बलात्कार के मामले में तीन लोगों को गिरफ्तार किया","counts":{"articles":7,"independent_sources":6,"outlets":7},"has_established":false,"qualified_by":"interim","perspective_mode":"none","perspectives":{"–":["Brut","Free Press Kashmir","India Today","NDTV","NDTV India","News18","The Hindu"]},"framing":[],"suicide":false,"thread":72622,"parents":[{"story_id":72622,"headline":"कैनाकोना बलात्कार: पुलिस ने चार साल की बच्ची के कथित बलात्कार के मामले में बिहार के मूल निवासी को गिरफ्तार किया"}],"children":[],"written_at":"2026-11-26T00:57:08","category":{"v":2,"primary":["india"],"secondary":["justice"],"tertiary":["crime","probes"]},"places":["delhi"],"people":["Preet Vihar","East Delhi","Delhi Police","Sultanate Cafe","(East) Rajeev Kumar","Bharatiya Nyaya Sanhita","Mandawali","unnamed source"],"narrative":{"paragraphs":[[{"text":"दिल्ली पुलिस ने ईस्ट दिल्ली के प्रीत विहार में एक सामूहिक बलात्कार की शिकायत के सिलसिले में तीन लोगों को कल गिरफ्तार किया।","ids":[169344],"class":"partial","sources":[1,2,3,4,5]}],[{"text":"सोमवार को समूह ने एक कैफे में और फिर मंडावली में एक सहकर्मी के आवास पर शराब पी और उसके बाद प्रीत विहार स्थित कैफे (Saltanate Cafe) में वापस लौट आए।","ids":[169373],"class":"single","sources":[4]}],[{"text":"एक 22 वर्षीय महिला ने सोमवार रात प्रीत विहार स्थित सल्तनत कैफे में अपने सहकर्मियों के साथ पार्टी में भाग लिया।","ids":[169363],"class":"single","sources":[6]},{"text":"समूह कथित तौर पर सुबह लगभग 3:30 बजे निकला।","ids":[169358],"class":"single","sources":[3]},{"text":"महिला ने सुबह 5:45 बजे पुलिस में शिकायत दर्ज कराई।","ids":[169359],"class":"single","sources":[3]},{"text":"कैफे बंद होने के बाद समूह ने अतिरिक्त चाबी से जगह को फिर से खोला और सुबह तक वहां रहे।","ids":[169351],"class":"partial","sources":[2,5]}],[{"text":"पार्टी के दौरान दो पुरुषों द्वारा पीड़िता के साथ कथित तौर पर सामूहिक बलात्कार किया गया जबकि समूह के अन्य लोगों ने उनकी मदद की।","ids":[169364],"class":"partial","sources":[5,6]},{"text":"पुलिस ने इस मामले के सिलसिले में दो महिलाओं सहित तीन लोगों को गिरफ्तार किया, बताया कि आठ सहकर्मी इस पार्टी में शामिल हुए थे, भारतीय न्याय संहिता के तहत चार पुरुषों और दो महिलाओं के खिलाफ मामला दर्ज किया और बताया कि तीन अन्य आरोपी अभी भी फरार हैं।","ids":[169365,169354,169367,169376],"class":"single","sources":[2,5,6]},{"text":"डिप्टी कमिश्नर ऑफ पुलिस (East) राजीव कुमार ने दो महिलाओं और एक पुरुष की गिरफ्तारी की पुष्टि की।","ids":[169345,169365],"class":"single","sources":[1,6]},{"text":"प्रीत विहार के एक कैफे में 22 वर्षीय महिला के साथ दो पुरुष सहकर्मियों द्वारा कथित तौर पर सामूहिक बलात्कार किया गया, पीड़िता ने कहा।","ids":[169369],"class":"partial","sources":[1,3,4]},{"text":"समूह ने मंगलवार सुबह 3.30 बजे तक कैफे में शराब पी, अनाम सूत्र ने कहा।","ids":[169378],"class":"single","sources":[2]},{"text":"पुलिस सूत्रों ने बताया कि कैफे रात 11.30 बजे बंद हुआ।","ids":[169380],"class":"single","sources":[2]}],[{"text":"मामले में छह लोगों को नामजद किया गया है।","ids":[169347],"class":"single","sources":[1]}],[{"text":"पुलिस ने बताया कि फरार चल रहे शेष तीन संदिग्धों को गिरफ्तार करने के लिए तलाशी अभियान जारी है।","ids":[169368],"class":"partial","sources":[4,5,6]}]],"section_keys":["news","background","happened","say","numbers","next"],"sources":[{"n":1,"url":"https://www.brut.media/in/articles/india/society/delhi-gang-rape-case-woman-accuses-colleagues-three-arrested","outlet":"Brut","title":"Preet Vihar Gang-Rape Case: Three Arrested In Delhi","perspective":"–","read":true,"readable":true},{"n":2,"url":"https://freepresskashmir.news/2026/11/25/three-arrested-after-woman-alleges-gang-rape-by-colleagues-at-east-delhi-c/amp/","outlet":"Free Press Kashmir","title":"Three arrested after woman alleges gang rape by colleagues at east Delhi c","perspective":"–","read":true,"readable":true},{"n":3,"url":"https://www.news18.com/india/22-year-old-woman-gang-raped-by-colleagues-after-party-at-delhi-cafe-3-held-including-2-women-ws-l-10439720.html","ou