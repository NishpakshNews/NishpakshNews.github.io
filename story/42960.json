ources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"तीन राउंड के बाद टूर्नामेंट में केवल आठ खिलाड़ी सब-पार हैं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"पोर्नानोंग फैटलुम टूर्नामेंट के लिए 4-अंडर पर थीं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"प्रणवी उर्स अर्जेंटीना की मैग्डालेना सिम्मरमाचर के साथ चौथे स्थान पर बराबरी पर हैं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"त्वेसा मलिक सब-पार रहने वाली दूसरी भारतीय थीं, जिनका एक-अंडर 71 का स्कोर उन्हें आठवें स्थान पर रखता है।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"प्रणवी उर्स एलईटी (LET) स्वीकृत टूर्नामेंट में चौथे स्थान पर बराबरी पर थीं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"प्रणवी उर्स ने फ्रंट नाइन पर अपने पहले छह होल्स में पांच बर्डी लगाईं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"प्रणवी उर्स का खेल बैक नाइन पर फिसल गया, जिसमें तीन बर्डी तीन बोगी से रद्द हो गईं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"प्रणवी उर्स लीड से दो शॉट पीछे रहीं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"वाणी कपूर ने तीसरे दौर में अपने पहले 11 होल्स में चार बर्डी लगाईं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"वाणी कपूर ने तीसरे दौर के अंतिम चार होल्स में दो बोगी और एक बर्डी लगाई।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"प्रणवी उर्स ने प्रो-एम डे के बाद से भोजन नहीं किया है।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"attributes"}]},{"text":"प्रणवी उर्स हर शॉट के बाद बैठ रही थीं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"attributes"}]},{"text":"रविवार की दौड़ खुली रहने की संभावना है।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"वाणी कपूर ने फ्रंट नाइन पर तीन बर्डी लगाईं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"The Hindu","url":"https://www.thehindu.com/sport/other-sports/hero-womens-indian-open-vani-in-the-van-for-the-first-time-ever-in-a-let-event/article71619981.ece","stance":"asserts"}]},{"text":"वाणी कपूर ने बैक नाइन पर दो बर्डी लगाईं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"The Hindu","url":"https://www.thehindu.com/sport/other-sports/hero-womens-indian-open-vani-in-the-van-for-the-first-time-ever-in-a-let-event/article71619981.ece","stance":"asserts"}]},{"text":"वाणी कपूर ने 18वें होल पर एक बोगी लगाई।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"The Hindu","url":"https://www.thehindu.com/sport/other-sports/hero-womens-indian-open-vani-in-the-van-for-the-first-time-ever-in-a-let-event/article71619981.ece","stance":"asserts"}]},{"text":"वाणी कपूर ने कहा कि यह उनके द्वारा खेले गए सबसे मजेदार राउंड्स में से एक था।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"attributes"}]},{"text":"वाणी कपूर ने कहा कि वे शांत हैं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"attributes"}]},{"text":"प्रणवी उर्स ने कहा कि वे थक गई थीं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"attributes"}]},{"text":"प्रणवी उर्स ने कहा कि बैक नाइन में उनका शरीर जवाब दे गया था।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"attributes"}]},{"text":"प्रणवी उर्स ने कहा कि उन्होंने प्रो-एम डे के बाद से भोजन किया है।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"attributes"}]},{"text":"वाणी कपूर ने कहा कि वह शांत नहीं हैं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"attributes"}]},{"text":"वाणी कपूर ने कहा कि वह अंतिम दिन के लिए इसी तरह बने रहने की उम्मीद करती हैं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"attributes"}]},{"text":"यह हाल ही में एशियाई गेम्स चैंपियन बनीं प्रणवी उर्स नहीं हैं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]},{"text":"यह अनुभवी वाणी कपूर हैं।","verdict":"unverified","n_sources":1,"sources":[{"outlet":"Hindustan Times","url":"https://www.hindustantimes.com/sports/others/womens-indian-open-vani-kapoor-takes-one-shot-lead-into-final-day-101792858567327.html","stance":"asserts"}]}],"context":[]}}