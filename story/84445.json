unts":{"articles":2,"independent_sources":2,"outlets":2},"has_established":false,"qualified_by":"express","perspective_mode":"none","perspectives":{"–":["Aaj Tak","Times of India"]},"framing":[],"suicide":false,"thread":84445,"parents":[],"children":[],"written_at":"2026-11-19T03:10:38","category":{"v":2,"primary":["india"],"secondary":["life"],"tertiary":["sport-films"]},"places":["bihar","delhi"],"people":["Prashant Singh","Raghuvendra Pratap Singh","Ayush Loharuka","Bipin Saurabh","Keshav Dabas","Mayank Kumar","Vaibhav Sooryavanshi","ACC Men's Asia Cup Rising"],"narrative":{"paragraphs":[[{"text":"बुधवार 18 नवंबर 2026 को, दिल्ली ने 20 ओवर में 5 विकेट पर 224 रन बनाए।","ids":[147898],"class":"unverified","sources":[1,2]}],[{"text":"बुधवार 18 नवंबर 2026 को, बिहार ने 19.5 ओवर में आठ विकेट पर 227 रन बनाए, और 17वें ओवर में आठ विकेट पर 189 रन तक पहुंचा।","ids":[147906,147915],"class":"single","sources":[2]},{"text":"बिहार ने अपने पीछा करने के पहले छह ओवर में 96 रन बनाए।","ids":[147910],"class":"single","sources":[2]},{"text":"बिहार के कप्तान वैभव सूर्यवंशी मैच में नहीं खेले।","ids":[147896],"class":"single","sources":[1]}],[{"text":"बिहार ने सैयद मुश्ताक अली टी20 ट्रॉफी मैच में दिल्ली को 2 विकेट से हराया।","ids":[147895],"class":"unverified","sources":[1,2]},{"text":"आयुष लोहारुका ने 22 गेंदों में 50 रन बनाए, बिपिन सौरभ ने 19 गेंदों में 49 रन बनाए, तेजस्वी दहिया ने 25 गेंदों में 51 रन बनाए, और दिल्ली के गेंदबाज केशव डबास ने 3 ओवर में 51 रन दिए।","ids":[147911,147912,147900,147904],"class":"single","sources":[1,2]}],[{"text":"यश धुल ने दिल्ली के लिए 59 गेंदों में 125 रन बनाए।","ids":[147920],"class":"partial","sources":[1,2]},{"text":"लोहारुका और सौरभ ने दूसरे विकेट के लिए 103 रन जोड़े।","ids":[147924],"class":"single","sources":[2]}],[{"text":"दिग्वेश सिंह राठी ने दिल्ली के लिए 47 रन देकर तीन विकेट लिए, रघुवेन्द्र प्रताप सिंह ने बिहार के लिए 44 रन देकर तीन विकेट लिए, और प्रशांत सिंह और सूरज कश्यप ने एक-एक विकेट लिया, जबकि सुयश शर्मा और डबास ने दिल्ली के लिए एक-एक विकेट 