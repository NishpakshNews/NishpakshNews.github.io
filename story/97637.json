ndent_sources":6,"outlets":6},"has_established":false,"qualified_by":"interim","perspective_mode":"none","perspectives":{"–":["Aaj Tak","Amar Ujala","Jagran","Live Hindustan","NDTV","News18"]},"framing":[],"suicide":false,"thread":97637,"parents":[],"children":[],"written_at":"2026-11-26T01:10:41","category":{"v":2,"primary":["india"],"secondary":["life","justice"],"tertiary":["weather","crime"]},"places":["maharashtra"],"people":["Bopdev Ghat","CM Sunetra Pawar","Yewalewadi","Inamdar Hospital","Kondhwa","Maruti Patil","Mohini Chaudhary","Prateek Maruti Chavan"],"narrative":{"paragraphs":[[{"text":"बुधवार दोपहर को हुई इस दुर्घटना में तीन छात्रों की मृत्यु हो गई।","ids":[169391],"class":"unverified","sources":[1,2]}],[{"text":"बुधवार को, पुलिस ने 22 वर्षीय ट्रक चालक को हिरासत में लिया, और बुधवार 25 नवंबर 2026 को, पुलिस ने चालक को हिरासत में ले लिया, और 26 नवंबर 2026 को, पुलिस ने टेम्पो चालक [Prateek] [Maruti] [Chavan] को गिरफ्तार किया।","ids":[169386,169403,169408],"class":"single","sources":[2,3,4,5]}],[{"text":"बुधवार, 25 नवंबर 2026 को पुणे के येवालेवाड़ी क्षेत्र में एक तेज रफ्तार ट्रक अनियंत्रित हो गया।","ids":[169401],"class":"single","sources":[4]},{"text":"वह बोपदेव घाट की खड़ी ढलान से नीचे उतर रहा था, और नीचे उतरते समय उसका नियंत्रण खो गया।","ids":[169388,169399],"class":"single","sources":[2,3,4]}],[{"text":"इलाज के दौरान तीन छात्रों की मृत्यु हो गई, और 26 नवंबर 2026 को, विभिन्न अस्पतालों में भर्ती कराए जाने के बाद तीन छात्रों की मृत्यु हो गई।","ids":[169402,169407],"class":"single","sources":[4,5]}],[{"text":"बुधवार २५ नवंबर २०२६ को इसके बाद ट्रक ने बस स्टॉप पर खड़े छात्रों को टक्कर मार दी।","ids":[169414],"class":"single","sources":[4]},{"text":"बुधवार दोपहर को महाराष्ट्र के पुणे के येवलेवाड़ी इलाके में एक ट्रक ने एक कार और फिर बस स्टॉप पर खड़े छात्रों को टक्कर मार दी।","ids":[169384,169390,169397],"class":"single","sources":[1,2,3,4]}],[{"text":"बुधवार दोपहर को इस हादसे में छह अन्य छात्र घायल हो गए।","ids":[169392],"class":"single","sources":[1]}],[{"text":"दुर्घटना का कारण जांच के अधीन है।","ids":[169394],"class":"single","sources":[1]}],[{"text":"घायलों का वानवडी स्थित रूबी हॉल क्लिनिक और पुणे के कोंढवा स्थित इनामदार अस्पताल में इलाज चल रहा है।","ids":[169400],"class":"single","sources":[2]}],[{"text":"मृतकों की पहचान सिद्धेश राजे, विशाल डांगडे और मोहिनी चौधरी के रूप में हुई है।","ids":[169409],"class":"single","sources":[5]}],[{"text":"मारुति पाटिल ने बताया कि बोपदेव घाट से ढलान से नीचे आ रहा एक टेम्पो अपने आगे चल रही एक कार से टकरा गया, टेम्पो चालक ने वाहन से नियंत्रण खो दिया और चालक ने कॉलेज के मुख्य गेट के पास बस स्टॉप पर इंतजार कर रहे छात्रों को टक्कर मार दी।","ids":[169406,169415,169416],"class":"single","sources":[5]}],[{"text":"शुरुआती जानकारी में बताया गया कि घाट में एक मोड़ पर ट्रक चालक ने वाहन से नियंत्रण खो दिया।","ids":[169393],"class":"single","sources":[1]}],[{"text":"महाराष्ट्र की उपमुख्यमंत्री सुनेत्रा पवार ने दुर्घटना पर दुख व्यक्त किया।","ids":[169395],"class":"single","sources":[1]}],[{"text":"The accident (Rajasthan Accident) occurred at 2.30 pm in the Yewalewadi area.","ids":[169387],"class":"single","sources":[3]}],[{"text":"दुर्घटना में दो छात्र, श्वेता तालेकर और सोहम घांगळे, घायल हो गए।","ids":[169404],"class":"partial","sources":[2,3,4,5]}],[{"text":"पवार ने अधिकारियों को निर्देश दिया कि घायलों को नजदीकी अस्पताल में भर्ती कराया जाए और बेहतर इलाज मुहैया कराया जाए।","ids":[169396],"class":"single","sources":[1]}]],"section_keys":["news","happened","happened","happened","happened","happened","happened","happened","happened","say","say","say","numbers","numbers","next"],"sources":[{"n":1,"url":"https://www.aajtak.in/india/maharashtra/story/pune-bopdev-ghat-truck-accident-many-students-dead-cctv-ntc-aktw-rptc-2706028-2026-11-25","outlet":"Aaj Tak","title":"VIDEO: बस का इंतजार कर रहे थे छात्र,  बेकाबू ट्रक ने रौंदा, तीन की मौत","perspective":"–","read":true,"readable":true},{"n":2,"url":"https://www.jagran.com/news/national-three-students-killed-two-injured-as-speeding-truck-rams-into-car-in-pun